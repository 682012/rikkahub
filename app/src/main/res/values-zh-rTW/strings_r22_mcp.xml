    <string name="r22_mcp_allow_read">讀取</string>
    <string name="r22_mcp_allow_read_note">讀取對話清單、訊息、封存與任務狀態（唯讀）</string>
    <string name="r22_mcp_allow_mutations">寫入</string>
    <string name="r22_mcp_allow_mutations_note">改標題、送出訊息、封存、刪除等會改動 App 資料的操作</string>
    <string name="r22_mcp_allow_model">模型請求</string>
    <string name="r22_mcp_allow_model_note">讓外部用戶端觸發真正的模型生成（會消耗你的額度）</string>
    <string name="r22_mcp_allow_device">裝置操作</string>
    <string name="r22_mcp_allow_device_note">跨 App 點擊／輸入，需你另外在系統中啟用無障礙服務並授權</string>
    <string name="r22_mcp_allow_automation">本機自動化</string>
