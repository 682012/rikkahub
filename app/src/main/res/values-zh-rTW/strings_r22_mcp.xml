    <string name="r22_mcp_enable">啟用本機 MCP</string>
    <string name="r22_mcp_enable_note">開啟後會啟動前景服務並在 127.0.0.1 上監聽；關閉就立刻停止。開關只代表你的意圖，實際結果看上面的執行狀態。</string>

    <string name="r22_mcp_port">連接埠</string>
    <string name="r22_mcp_port_hint">1024–65535，預設 8766</string>
    <string name="r22_mcp_port_apply">套用</string>
    <string name="r22_mcp_port_invalid">連接埠需介於 1024–65535</string>

    <string name="r22_mcp_assistant">開放給外部用戶端的助理</string>
    <string name="r22_mcp_assistant_none">未選擇（不開放內建對話）</string>
    <string name="r22_mcp_assistant_note">必須在這裡明確選一個助理，外部用戶端才會看到內建對話／訊息工具。不選不等於「所有助理」。</string>
    <string name="r22_mcp_assistant_required">尚未選擇助理</string>
