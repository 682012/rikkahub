    <string name="r22_mcp_enable">启用本机 MCP</string>
    <string name="r22_mcp_enable_note">打开后启动前台服务并在 127.0.0.1 上监听；关掉就立刻停服。开关只表示你的意图，真实结果看上面的运行状态。</string>

    <string name="r22_mcp_port">端口</string>
    <string name="r22_mcp_port_hint">1024–65535，默认 8766</string>
    <string name="r22_mcp_port_apply">应用</string>
    <string name="r22_mcp_port_invalid">端口要在 1024–65535 之间</string>

    <string name="r22_mcp_assistant">暴露给外部客户端的助手</string>
    <string name="r22_mcp_assistant_none">未选择（不暴露内置会话）</string>
    <string name="r22_mcp_assistant_note">必须在这里明确选一个助手，外部客户端才会看到内置会话/消息工具。不选不等于"所有助手"。</string>
    <string name="r22_mcp_assistant_required">还没选助手</string>
    <string name="r22_mcp_select_assistant">选择助手</string>

