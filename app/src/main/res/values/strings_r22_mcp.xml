    <string name="r22_mcp_allow_device">设备操作</string>
    <string name="r22_mcp_allow_device_note">跨 App 点击/输入，需要你另外在系统里启用无障碍服务并授权</string>
    <string name="r22_mcp_allow_automation">本地自动化</string>
    <string name="r22_mcp_allow_automation_note">运行你已保存的本地自动化配方，不会自己新建或改配方</string>

