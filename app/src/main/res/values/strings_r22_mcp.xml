    <string name="r22_mcp_allow_read">读取</string>
    <string name="r22_mcp_allow_read_note">读会话列表、消息、归档与任务状态（只读）</string>
    <string name="r22_mcp_allow_mutations">写入</string>
    <string name="r22_mcp_allow_mutations_note">改标题、发消息、归档、删除等会改 App 数据的操作</string>
    <string name="r22_mcp_allow_model">模型请求</string>
