    <string name="r22_device_master">允许设备操控</string>
    <string name="r22_device_master_desc">默认关闭。关掉后读取和操作立即停止，即使系统里的服务还开着。</string>
    <string name="r22_device_allow_read">读取屏幕</string>
    <string name="r22_device_allow_read_desc">抓取白名单 App 的无障碍树。</string>
    <string name="r22_device_allow_act">点击与输入</string>
    <string name="r22_device_allow_act_desc">在白名单 App 内点击、长按、填字与手势。</string>
    <string name="r22_device_allow_global">返回、桌面与启动 App</string>
    <string name="r22_device_allow_global_desc">系统级动作；启动 App 仍要求目标包在白名单内。</string>
    <string name="r22_device_whitelist_title">允许的 App</string>
    <string name="r22_device_whitelist_desc">只有这些包能被读取或操作，列表为空则全部禁止。</string>
    <string name="r22_device_whitelist_hint">包名，例如 com.android.settings</string>
