<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="r22_device_title">本机设备操控</string>
    <string name="r22_device_service_description">无障碍服务：只读取你允许的 App 的当前屏幕并代你点击。随时可在这里或系统设置中关闭。</string>
    <string name="r22_device_risk">开启后，AI 或本机自动化脚本可以读取当前屏幕，并代你点击、滑动、输入、打开其他 App。只有下面列出的 App 能被操作；在系统无障碍设置里勾选本服务之前，什么都不会执行。密码类输入框一律不读也不点。随时可以在这里关掉，或到系统设置里撤销。</string>
    <string name="r22_device_status_title">服务状态</string>
    <string name="r22_device_status_enabled_system">已在系统设置中启用</string>
    <string name="r22_device_status_connected">无障碍服务已连接</string>
    <string name="r22_device_status_disconnected">无障碍服务未连接</string>
