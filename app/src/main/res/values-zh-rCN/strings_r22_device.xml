    <string name="r22_device_add_current">添加当前前台 App</string>
    <string name="r22_device_remove">移除</string>
    <string name="r22_device_whitelist_empty">还没有允许任何 App。</string>
    <string name="r22_device_automation_title">本地自动化</string>
    <string name="r22_device_automation_desc">给配方起个名字，写纯 JSON 工具步骤。运行时不需要任何模型，只用当前真实可用的工具；步骤串行执行，遇到失败或需要审批立即停下。</string>
    <string name="r22_device_recipe_name">配方名称</string>
