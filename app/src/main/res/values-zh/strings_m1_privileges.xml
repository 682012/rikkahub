<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="m1_priv_entry_title">高级权限与设备能力</string>
    <string name="m1_priv_entry_desc">Shizuku 通道、开发级权限、系统特殊访问和 AI 自动化控制。</string>
    <string name="m1_priv_entry_shizuku">Shizuku 通道</string>
    <string name="m1_priv_entry_shizuku_desc">查看真实通道状态；授权弹窗只有你点的时候才出现。</string>
    <string name="m1_priv_entry_dev">开发级权限</string>
    <string name="m1_priv_entry_dev_desc">WRITE_SECURE_SETTINGS、DUMP、READ_LOGS、CHANGE_CONFIGURATION，可逐项授予与撤销。</string>
    <string name="m1_priv_entry_special">系统特殊访问</string>
    <string name="m1_priv_entry_special_desc">修改系统设置、使用情况访问、免打扰、精确闹钟、所有文件等。</string>
    <string name="m1_priv_entry_automation">AI 自动化控制</string>
    <string name="m1_priv_entry_automation_desc">默认关闭；写操作单独开关；必须明确选择一个助手。</string>
    <string name="m1_priv_entry_open">打开</string>

    <string name="m1_priv_sheet_title">高级权限与设备能力</string>
    <string name="m1_priv_shell_boundary">边界：本页只反映系统真实回执。Shizuku 是 shell 级通道，不会 root 设备，不能获得系统签名专属权限，也读不到其它应用的私有目录。</string>
    <string name="m1_priv_loading">正在读取真实状态…</string>
    <string name="m1_priv_load_failed">读取失败：%1$s</string>
    <string name="m1_priv_retry">重试</string>
    <string name="m1_priv_unavailable">当前设备不支持</string>
    <string name="m1_priv_dismiss">关闭</string>
    <string name="m1_priv_action_failed">操作失败：%1$s</string>
    <string name="m1_priv_state_system_only">仅系统/签名应用，普通授权拿不到</string>
    <string name="m1_priv_bound_group">本应用自身组件</string>
    <string name="m1_priv_bound_desc">无障碍、通知监听等由系统设置页绑定，本页不会替你静默打开。</string>
    <string name="m1_priv_runtime_group">运行时权限</string>
    <string name="m1_priv_notes_group">本机补充说明</string>
    <string name="m1_priv_dev_result_no_effect">命令已执行，但权限状态没有按要求改变</string>

    <string name="m1_priv_shizuku_group">Shizuku 通道</string>
    <string name="m1_priv_shizuku_status">通道状态</string>
    <string name="m1_priv_shizuku_state_missing">未安装 Shizuku</string>
    <string name="m1_priv_shizuku_state_authorized">已授权</string>
    <string name="m1_priv_shizuku_authorize">请求 Shizuku 授权</string>
    <string name="m1_priv_shizuku_authorize_desc">不点这个按钮就不会发起任何授权请求，确认界面由 Shizuku 自己弹出。</string>
    <string name="m1_priv_shizuku_authorizing">正在等待 Shizuku…</string>
    <string name="m1_priv_shizuku_failed">授权失败：%1$s</string>
    <string name="m1_priv_shizuku_no_root">Shizuku 只是 shell 级能力：不会 root 设备，也不能把本应用变成系统签名应用。普通用户授权不会变成系统权限。</string>

    <string name="m1_priv_dev_group">开发级权限</string>
    <string name="m1_priv_dev_desc">只能通过 Shizuku（adb shell pm grant）授予。这里的勾选只用于下面的批量按钮。</string>
    <string name="m1_priv_dev_granted">已授予</string>
    <string name="m1_priv_dev_denied">未授予</string>
    <string name="m1_priv_dev_select_hint">勾选要处理的项目，处理完每一项都会显示自己的真实结果。</string>
    <string name="m1_priv_dev_grant_selected">授予所选（%1$d）</string>
    <string name="m1_priv_dev_revoke_selected">撤销所选（%1$d）</string>
    <string name="m1_priv_dev_working">正在执行…</string>
    <string name="m1_priv_dev_result_ok">成功</string>
    <string name="m1_priv_dev_result_fail">失败</string>

    <string name="m1_priv_adb_group">ADB 命令</string>
    <string name="m1_priv_adb_desc">只有点击时才复制；包名取自本应用的实际情况（%1$s）。</string>
    <string name="m1_priv_adb_empty">当前设备没有可用命令</string>
    <string name="m1_priv_adb_copy">复制</string>
    <string name="m1_priv_adb_copied">已复制</string>

    <string name="m1_priv_special_group">系统特殊访问</string>
    <string name="m1_priv_special_desc">这些开关由系统设置页授予。回到本页会重新读取真实状态；清单里声明过不等于已授予。</string>
    <string name="m1_priv_special_manual">需手动开启</string>

    <string name="m1_priv_auto_group">AI 自动化控制</string>
    <string name="m1_priv_auto_master">允许 AI 操作本机</string>
    <string name="m1_priv_auto_master_desc">默认关闭。关闭会立即撤销当前自动化会话；权限不会从其它工作区继承。</string>
    <string name="m1_priv_auto_writes">允许写操作</string>
    <string name="m1_priv_auto_writes_desc">单独开关，默认关闭，只影响会改动设备的命令。</string>
    <string name="m1_priv_auto_assistant">执行助手</string>
    <string name="m1_priv_auto_assistant_desc">必须明确选一个助手；没选之前不对任何助手开放。</string>
    <string name="m1_priv_auto_assistant_invalid">所选助手已不存在，请重新选择</string>
    <string name="m1_priv_auto_pick">选择</string>
    <string name="m1_priv_auto_need_assistant">先选择一个助手，才能开启</string>
    <string name="m1_priv_auto_scope">可执行：读写系统设置、诊断、上面已授权的 Shizuku 命令。仅 shell 级，不是最高权限，也读不到其它应用的私有目录。</string>

    <string name="m1_priv_cap_group">可用功能</string>
    <string name="m1_priv_cap_settings">修改系统设置</string>
    <string name="m1_priv_cap_settings_desc">开启自动化并授予 WRITE_SECURE_SETTINGS 后由 AI 工具执行；本页只显示状态。</string>
    <string name="m1_priv_cap_diag">设备诊断</string>
    <string name="m1_priv_cap_diag_desc">读取屏幕结构、性能与权限状态供 AI 判断，不修改任何数据。</string>
    <string name="m1_priv_cap_shizuku">已授权的 Shizuku 命令</string>
    <string name="m1_priv_cap_shizuku_desc">只有上面已授予的开发级权限会作为 shell 命令提供；其余命令会被拒绝。</string>
</resources>
