    <string name="m1_runtime_review_collapse">收起</string>
    <string name="m1_runtime_review_cancel">取消审查</string>
    <string name="m1_runtime_review_dismiss">关闭</string>

    <string name="m1_runtime_group_delivery">生成中插话</string>
    <string name="m1_runtime_delivery_title">生成中发出的消息怎么送达</string>
    <string name="m1_runtime_delivery_queue">排队（默认）</string>
    <string name="m1_runtime_delivery_next">下一 step 前插入</string>
    <string name="m1_runtime_delivery_desc">「下一 step 前插入」会在模型下一个安全 step 之前把你的话带进去；已经发出去的请求和正在执行的工具不会被打断或强改。带附件时仍按排队处理。</string>

    <string name="m1_runtime_group_profile">客户端协议档</string>
    <string name="m1_runtime_profile_native">原生</string>
    <string name="m1_runtime_profile_auto">自动</string>
    <string name="m1_runtime_profile_codex">Codex 风格</string>
    <string name="m1_runtime_profile_claude">Claude Code 风格</string>
    <string name="m1_runtime_profile_pi">PI 风格</string>
    <string name="m1_runtime_profile_desc">只调整请求头和一小段工具用法提示，按当前 provider 和模型在本地判别，AUTO 不发任何探测请求。不兼容的档自动回原生发送——不伪造官方权限、凭证或身份。</string>
    <string name="m1_runtime_profile_current">当前生效：%1$s</string>
    <string name="m1_runtime_profile_fallback">所选档与当前模型不兼容，已按原生发送。</string>
    <string name="m1_runtime_profile_unknown">还没选模型——选好模型后才能看到本地判定结果。</string>

    <string name="m1_runtime_group_knowledge">本地知识库</string>
    <string name="m1_runtime_knowledge_title">允许这个对话查本助手的资料</string>
    <string name="m1_runtime_knowledge_desc">导入和检索都在本机。开启后，命中你这条消息的片段会随请求发给本对话的模型——只发命中的片段，不会把整份原文塞进去。</string>
    <string name="m1_runtime_knowledge_manage">管理和导入资料</string>
    <string name="m1_runtime_knowledge_manage_desc">范围是本对话所属的助手。</string>

    <string name="m1_runtime_group_tools">工具执行</string>
    <string name="m1_runtime_efficient_title">高效工具</string>
    <string name="m1_runtime_efficient_desc">在系统提示里加一段精简的执行指引（先读再改、最小 diff、只跑会失败的最窄检查）。只是提示，不承诺模型一定采用最优策略。</string>

